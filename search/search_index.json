{"config":{"lang":["zh","en","ja"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4f60\u597d\uff01","text":"<p>\u8fd9\u91cc\u662f\u84dd\u84dd\u5b89\u665a  </p> <p>\u6211\u4f1a\u5728\u8fd9\u91cc\u66f4\u65b0\u4e00\u4e9b\u6211\u7684\u7b14\u8bb0  </p> <p>\u5982\u679c\u4f60\u662f     - \u7535\u8111\u7aef\uff1a\u5728\u4e0a\u65b9\u6807\u7b7e\u680f\u9009\u62e9\u4e3b\u9898\uff0c\u5728\u5de6\u4fa7\u76ee\u5f55\u9009\u62e9\u6587\u7ae0     - \u79fb\u52a8\u7aef\uff1a\u70b9\u51fb\u5de6\u4e0a\u89d2\u56fe\u6807\u9009\u62e9\u4e3b\u9898\u548c\u6587\u7ae0  </p> <p>\u4f60\u4e5f\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u680f\u67e5\u627e\u5173\u952e\u8bcd</p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/","title":"\u52a8\u89c4\u7684\u603b\u7ed3 02\uff1a\u540c\u63cf\u3001\u66f4\u65b0\u7387","text":""},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#00","title":"00 \u5f15\u8a00\uff1a\u540c\u63cf\u4e0e\u66f4\u65b0\u7387","text":"<p>2024/8/7\u00a019:17:35 \u84dd\u84dd\u5b89\u665a      \u5176\u5b9e\u6211\u89c9\u5f97\u4e8c\u503c\u7b14\u64ad\u653e\u7a33\u5b9a\u8fd9\u6761\u5176\u5b9e\u5fae\u4e0d\u8db3\u9053     \u5982\u679c\u6211\u9700\u8981\u8ba9\u8fd9\u4e2a\u90e8\u5206\u300c\u4e0d\u52a8\u300d     \u90a3\u6211\u5c31\u5199\u6307\u793a\u5408\u6210     \u8fd9\u6837\u5c31\u662f\u7ebf\u5b8c\u5168\u6ca1\u6709\u53d8\u5316\u7684\u300c\u9759\u6b62\u72b6\u6001\u300d      \u5982\u679c\u8fd9\u4e2a\u90e8\u5206\u6709\u52a8\uff0c\u90a3\u5c31\u662f\u8981\u8868\u73b0\u300c\u52a8\u300d\uff0c\u4e5f\u5c31\u4e0d\u9700\u8981\u8ba9\u4ed6\u7684\u7ebf\u4e0d\u52a8\u4e86     \u751a\u81f3\u4e3a\u4e86\u8ba9\u4e0d\u52a8\u7684\u90e8\u5206\u770b\u8d77\u6765\u6709\u5728\u52a8\uff0c\u4f1a\u540c\u63cf\u6296\u52a8      \u5c31\u6bd4\u5982\u4e00\u4e2a\u4eba\u5728\u6253\u6405\uff0c\u4f46\u662f\u4ed6\u5750\u5728\u6905\u5b50\u4e0a     \u53ea\u6709\u624b\u5728\u52a8     \u8eab\u4f53\u6ca1\u6709\u52a8     \u4f46\u662f\u5b9e\u9645\u6253\u6405\u7684\u65f6\u5019\u662f\u80a9\u8180\u5e26\u52a8\u624b\u81c2\u5728\u52a8     \u867d\u7136\u8eab\u4f53\u300c\u4e0d\u52a8\u300d\uff0c\u4f46\u662f\u53d1\u529b\u662f\u5168\u8eab\u7684     \u4e5f\u5c31\u662f\u8bf4\uff0c\u8eab\u4f53\u662f\u548c\u624b\u81c2\u8054\u52a8\u7684      \u5982\u679c\u8fd9\u4e2a\u65f6\u5019\u8eab\u4f53\u5408\u6210\uff0c\u5c31\u4f1a\u5f88\u5272\u88c2     \u597d\u50cf\u624b\u548c\u8eab\u4f53\u662f\u5206\u5272\u5f00\u7684     \u6700\u597d\u5c31\u8ba9\u8eab\u4f53\u540c\u63cf      \u5c31\u662f\u4e00\u4e2a\u4e1c\u897f\uff0c\u867d\u7136\u4ed6\u6574\u4f53\u9020\u578b\u6ca1\u6709\u53d8     \u4f46\u662f\u968f\u7740\u5f71\u683c\u53d8\u5316\uff0c\u4ed6\u7684\u7ebf\u53d8\u5316\u4e86     \u5c31\u4f1a\u4ea7\u751f\u300c\u8fd9\u4e2a\u4e1c\u897f\u5728\u4ee5\u4e00\u5b9a\u901f\u5ea6\u52a8\u300d\u7684\u611f\u89c9     \u548c\u4ed6\u5b9e\u9645\u7684\u8fd0\u52a8\u662f\u5206\u5f00\u7684\u4e24\u79cd\u611f\u53d7      \u8fd9\u4e5f\u5c31\u662f\u4e3a\u4ec0\u4e48\u5c11\u7528\u6df7\u62cd     \u5982\u679c\u5728\u4e00\u5806\u62cd4\u91cc\u63ba\u4e86\u4e24\u5f20\u62cd2     \u5c31\u662f\u6df7\u62cd     \u8fd9\u4e2a\u65f6\u5019\u5c31\u7b97\u8fd0\u52a8\u901f\u5ea6\u6ca1\u53d8\uff0c\u56e0\u4e3a\u7a81\u7136\u5f71\u683c\u7684\u53d8\u5316\u901f\u7387\u53d8\u4e86\uff0c      \u5c31\u4f1a\u4ea7\u751f\u300c\u8fd9\u4e2a\u4e1c\u897f\u7a81\u7136\u5feb\u4e86\u4e00\u4e0b\u300d\u7684\u611f\u89c9   </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#01","title":"01 \u300c\u52a8\u611f\u300d","text":"<p>\u4e00\u5f20\u56fe\u540c\u63cf\u4e09\u5f20\uff0c\u62cd\u4e8c\u5faa\u73af   \u5c31\u80fd\u4ea7\u751f\u300c\u56fe\u7247\u6709\u5728\u52a8\u300d\u7684\u611f\u53d7 \u6b64\u65f6\u300c\u5728\u52a8\u300d\u4e0e\u300c\u5728\u8fd0\u52a8\u300d\u4e24\u79cd\u611f\u77e5\u88ab\u5206\u79bb\u4e86    </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#011","title":"011 \u300c\u52a8\u611f\u300d\u662f\u4ec0\u4e48","text":"<p>\u8fd9\u4e00\u611f\u77e5\uff0c\u53ea\u7531\u753b\u9762\u66f4\u65b0\u4ea7\u751f\u7684\u5fae\u5c0f\u8bef\u5dee\u53d8\u5316\u5bfc\u81f4  \u6211\u4eec\u5c06\u300c\u753b\u9762\u66f4\u65b0\u300d\u5bfc\u81f4\u7684\u300c\u753b\u9762\u5728\u52a8\u300d\u7684\u611f\u53d7  \u79f0\u4e4b\u4e3a\u300c\u52a8\u611f\u300d </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#012","title":"012 \u5f71\u54cd\u300c\u52a8\u611f\u300d\u7684\u56e0\u7d20","text":"<ul> <li>\u62cd\u6570\u3002\u6216\u8005\u8bf4\u753b\u9762\u7684\u66f4\u65b0\u9891\u7387 </li> <li>\u4e2d\u5272\u7684\u7ec6\u81f4\u7a0b\u5ea6\u3002\u300c\u52a8\u611f\u300d\u4e0e\u5b9e\u9645\u8fd0\u52a8\u7684\u5206\u79bb\uff0c\u662f\u300c\u753b\u9762\u66f4\u65b0\u7684\u5fae\u5c0f\u8bef\u5dee\u300d\u5bfc\u81f4\u7684\u3002\u6570\u7801\u4f5c\u753b\u65f6\u9010\u4e2a\u50cf\u7d20\u7684\u7ec6\u81f4\u4e2d\u5272\uff0c\u53ef\u4ee5\u6781\u5927\u964d\u4f4e\u300c\u52a8\u611f\u300d\u4e0e\u5b9e\u9645\u8fd0\u52a8\u7684\u5206\u79bb    </li> </ul>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#02_1","title":"02 \u6e05\u723d\u7684\u4f5c\u753b\u4e0e\u7c98\u7a20\u7684\u4f5c\u753b","text":"<p>\u6982\u62ec\u3001\u7b80\u7ec3\u7684\u4f5c\u753b\uff0c\u53ef\u4ee5\u5e26\u6765\u6e05\u723d\u7684\u8d28\u611f \u4f5c\u753b\u8ffd\u6c42\u5199\u5b9e\u3001\u7ec6\u817b\uff0c\u5bb9\u6613\u56e0\u6b64\u663e\u5f97\u7c98\u7a20  </p> <p>\u6e05\u723d\u4e0e\u7c98\u7a20\uff0c\u6b63\u662f\u300c\u52a8\u611f\u300d\u7a0b\u5ea6\u4e0d\u540c\u7684\u4e00\u79cd\u4f53\u73b0   </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#021","title":"021 \u7c98\u7a20\u611f\u7684\u673a\u7406","text":"<p>\u4f5c\u753b\u589e\u52a0\u5f20\u6570\uff0c\u6765\u5bb9\u7eb3\u5fae\u5c0f\u7684\u8fd0\u52a8\u3002   \u4f46\u662f\u753b\u9762\u66f4\u65b0\u7684\u8bef\u5dee\uff0c\u4f7f\u5f97\u5f20\u6570\u589e\u52a0\u4e4b\u540e\uff0c\u300c\u52a8\u611f\u300d\u4e5f\u5927\u5927\u589e\u52a0\u4e86   \u660e\u660e\u662f\u7ec6\u5fae\u7684\u52a8\u4f5c\uff0c\u5374\u56e0\u4e3a\u589e\u52a0\u5f20\u6570\u6765\u8868\u73b0\uff0c\u4ea7\u751f\u4e86\u4e0e\u4e4b\u4e0d\u76f8\u7b26\u7684\u300c\u52a8\u611f\u300d  \u8fd9\u5c31\u662f\u65f6\u95f4\u8f74\u7cfb\u4f5c\u753b\uff08\u90e8\u5206web\u7cfb\uff09\u770b\u8d77\u6765\u7c98\u7a20\u7684\u539f\u56e0   </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#022","title":"022 \u4f5c\u753b\u98ce\u683c\uff1a\u65b0\u7684\u5f52\u7eb3\u65b9\u5f0f","text":"<p>\u7528\u300c\u52a8\u611f\u300d\u7684\u7a0b\u5ea6\uff0c\u62c9\u6210\u4e00\u4e2a\u6c34\u5e73\u8f74    \u8d8a\u8ffd\u6c42\u6982\u62ec\u3001\u7b80\u7ec3\uff0c\u4f5c\u753b\u7684\u300c\u52a8\u611f\u300d\u4e0e\u8fd0\u52a8\u5927\u81f4\u76f8\u7b26\uff0c\u663e\u5f97\u6e05\u723d   \u8d8a\u8ffd\u6c42\u5199\u5b9e\u3001\u7ec6\u817b\uff0c\u4f5c\u753b\u4f1a\u56e0\u300c\u52a8\u611f\u300d\u4e0e\u8fd0\u52a8\u7684\u5206\u79bb\uff0c\u53d8\u5f97\u7c98\u7a20    </p> <p>\u6e05\u723d\u4f5c\u753b\u7684\u6781\u7aef\uff0c\u5c31\u662fLive2D   \u7c98\u7a20\u4f5c\u753b\u7684\u6781\u7aef\uff0c\u5c31\u662f\u89c6\u9891\u8f6c\u63cf  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2002%EF%BC%9A%E5%90%8C%E6%8F%8F%E3%80%81%E6%9B%B4%E6%96%B0%E7%8E%87/#023","title":"023 \u5e94\u5f53\u8ffd\u6c42\u7684\u539f\u5219\uff1a\u6f14\u51fa\u7684\u9700\u6c42\u4e0e\u771f\u6b63\u7684\u5199\u5b9e","text":"<p>\u5e94\u5f53\u6839\u636e\u5f71\u7247\u7684\u5b9e\u9645\u9700\u6c42\uff0c\u7ed8\u5236\u51fa\u98ce\u683c\u6070\u5f53\u7684\u4f5c\u753b\uff0c  \u4ee5\u671f\u5b8c\u6210\u9700\u8981\u7684\u8868\u6f14  \u5373\u52a8\u753b\u662f\u4e3a\u4e86\u5b9e\u73b0\u8868\u6f14 </p> <p>\u52a8\u753b\u5e08\u5e94\u5f53\u6df1\u5165\u5206\u6790\u4e8b\u7269\u8fd0\u52a8\u7684\u673a\u7406   \u7136\u540e\u52a0\u4ee5\u6982\u62ec\u3001\u63d0\u70bc  \u5728\u4e0d\u540c\u9700\u8981\u7684\u8868\u6f14\u4e2d\uff0c\u7528\u4e0d\u540c\u7684\u6982\u62ec\u7a0b\u5ea6\u6765\u8868\u73b0  \u4ee5\u671f\u5728\u6e05\u723d\u548c\u7c98\u7a20\u7684\u4f5c\u753b\u4e4b\u95f4\u5b9e\u73b0\u5e73\u8861\uff0c\u5c31\u662f\u771f\u6b63\u7684\u5199\u5b9e </p> <p>11:58  2024/09/17</p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/","title":"\u52a8\u89c4\u7684\u603b\u7ed3 03\uff1a\u52a8\u6001\u6a21\u7cca","text":""},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#00","title":"00 \u52a8\u6001\u6a21\u7cca\u6982\u8ff0","text":""},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#01","title":"01 \u672c\u8d28","text":"<p>\u53c2\u7167\u52a8\u89c4\u7684\u603b\u7ed3\u7b2c\u4e00\u7bc7\u7684\u63cf\u8ff0   \u52a8\u753b\u6bcf\u683c\uff0c\u8c61\u5f81\u7740\uff0c\u8fd9\u683c\u6301\u7eed\u653e\u6620\u7684\u8fd9\u201c\u4e00\u6bb5\u65f6\u95f4\u201d    </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#02","title":"02 \u8868\u73b0\u5f62\u5f0f\uff1a\u62d6\u5f71\u4e0e\u6b8b\u5f71","text":"<p>\u6b8b\u5f71\u76f8\u5f53\u4e8e\u662f\u628a\u524d\u4e00\u5f20\u7684\u4e2d\u5272\uff0c\u753b\u5230\u8fd9\u4e00\u5f20\u91cc\u9762\u6765  \u3010\u8111\u6d1e\u5b66\u751f\u4f1a\u3011  \u4e3a\u4e86\u5938\u5f20\u6253\u51fb\u7684\u901f\u5ea6\uff0c\u4ed6\u6253\u51fb\u53ea\u7ed9\u4e861\u5f20  \u4f46\u662f\u53ea\u7ed91\u5f20\u7684\u8bdd\uff0c\u89c2\u4f17\u80af\u5b9a\u770b\u4e0d\u6e05\u695a\u8fd9\u4e2a\u6253\u51fb  \u89e3\u51b3\u65b9\u6cd5\u5c31\u662f\uff0c\u628a\u6253\u51fb\u7684\u66f2\u7ebf\u753b\u51fa\u6765\uff0c\u628a\u6574\u4e2a\u6253\u51fb\u8fc7\u7a0b\u65f6\u95f4\u4e2d\u7684\u51e0\u4e2a\u52a8\u4f5c\uff0c\u753b\u6210\u6b8b\u5f71\uff0c\u5408\u5e76\u5230\u7b2c2\u5f20\u53bb  \u518d\u75282-3-4\u7684\u7f13\u52a8\uff0c\u5f15\u5bfc\u8fd9\u4e2a\u7b2c2\u5f20\u91cc\u62c9\u51fa\u6765\u7684\u8fd9\u4e2a\u66f2\u7ebf   \u4ee5\u6b64\u6765\u91cd\u65b0\u5efa\u7acb\u89c6\u89c9\u6682\u7559\u7684\u6548\u679c    </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#03_1","title":"03 \u5f71\u54cd\u56e0\u7d20","text":""},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#031","title":"031 \u76f8\u5bf9\u8fd0\u52a8\u901f\u5ea6\uff08\u89d2\u901f\u5ea6\uff09","text":"<p>\u5b9e\u9645\u4e0a\u5c31\u662f\u66dd\u5149\u671f\u95f4\uff0c\u4ea7\u751f\u7684\u8fd0\u52a8\u53d8\u5316\uff0c\u662f\u5426\u8db3\u591f\u5728\u753b\u5e45\u4e0a\u62c9\u51fa\u53ef\u89c1\u7684\u52a8\u6001\u6a21\u7cca  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#032","title":"032 \u5feb\u95e8\u901f\u5ea6","text":"<ul> <li>\u5e27\u7387\uff08\u62cd\u6570\uff09</li> <li>\u7167\u5ea6\uff08\u5f71\u54cd\u5feb\u95e8\u901f\u5ea6\uff09</li> <li>\u5149\u5708\uff08\u5f71\u54cd\u5feb\u95e8\u901f\u5ea6\uff0c\u540c\u65f6\u5f71\u54cd\u666f\u6df1\uff09</li> </ul>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#02_1","title":"02 \u52a8\u6001\u6a21\u7cca\u4e0e\u7a7a\u95f4\uff1a\u4ee5\u98d8\u96ea\u95ee\u9898\u4e3a\u4f8b","text":"<p>\u56e0\u4e3a\u98d8\u96ea\u662f\u4ee5\u4e00\u5b9a\u65b9\u5f0f\u5206\u5e03\u5728\u7a7a\u95f4\u4e2d  \u5e76\u53d1\u751f\u8fd0\u52a8\u7684\u666f\u7269  \u98d8\u96ea\u4f5c\u4e3a\u4e00\u79cd\u666f\u7269\uff0c\u6ca1\u6709\u4e00\u4e2a\u6709\u6548\u7684\u5f62\u4f53\uff0c\u4e00\u822c\u6765\u8bf4\u96be\u4ee5\u6210\u4e3a\u89c6\u89c9\u7684\u4e3b\u8981\u5143\u7d20\u3002\u800c\u66f4\u591a\u4f5c\u4e3a\u589e\u76ca\u7a7a\u95f4\u611f\u7684\u8f85\u52a9\u5143\u7d20    </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#021","title":"021 \u98d8\u96ea\u7684\u5206\u5c42","text":"<p>\u98d8\u96ea\u7684\u5c42\u6570=\u666f\u7247\u7684\u6570\u91cf+1 \u6bcf\u4e00\u5c42\u98d8\u96ea\uff0c\u7528\u4e8e\u6697\u793a\u67d0\u8be5\u5c42\u666f\u7247\u6240\u5904\u7684\u7a7a\u95f4   +1\u5c42\u98d8\u96ea\uff0c\u7528\u4e8e\u6697\u793a\u6444\u50cf\u673a\uff08\u773c\u775b\uff09\u6240\u5904\u7684\u7a7a\u95f4  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#_1","title":"\u7b80\u6790\u51e0\u4e2a\u6848\u4f8b","text":"<ul> <li> <p>\u4f8b1 \u4e00\u4e2a\u957f\u7126\u955c\u5934\u7684\u753b\u9762 \u753b\u9762\u4e2d\u7684\u5185\u5bb9\u5168\u90e8\u4f4d\u4e8e\u4e2d\u8fdc\u8ddd\u79bb\uff0c\u7a7a\u95f4\u88ab\u538b\u7f29   \u6545\u800c\u53ea\u67091\u4e2a\u666f\u7247  1+1=2\u5c42\u98d8\u96ea </p> </li> <li> <p>\u4f8b2 \u540c\u4f8b1</p> </li> <li> <p>\u4f8b3 \u80cc\u666f\u8ddd\u79bb\u89d2\u8272\u5f88\u8fdc\uff0c\u89c6\u4e3a\u4e24\u4e2a\u666f\u7247  2+1=3\u5c42\u98d8\u96ea   </p> </li> <li> <p>\u4f8b4 \u540c\u4f8b3</p> </li> <li> <p>\u4f8b5 \u89d2\u8272\u4f4d\u4e8e\u8f66\u7ad9\u68da\u5b50\u4e0b\u3002\u80cc\u666f\u7f3a\u5c11\u4e00\u5c42\u96ea 2+1-1=2\u5c42\u98d8\u96ea  </p> </li> </ul>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93%2003%EF%BC%9A%E5%8A%A8%E6%80%81%E6%A8%A1%E7%B3%8A/#022","title":"022 \u96ea\u82b1\u7684\u5c3a\u5bf8","text":"<ul> <li>\u540c\u4e00\u753b\u5e45\u3001\u540c\u4e00\u8ddd\u79bb\u3001\u540c\u4e00\u901f\u5ea6\u7684\u96ea\u82b1\uff0c\u5c3a\u5bf8\u3001\u5f62\u72b6\uff08\u52a8\u6001\u6a21\u7cca\u7684\u7a0b\u5ea6\uff09\u5e94\u76f8\u5f53\u3002</li> <li>\u4f8b5\u7684\u96ea\u82b1\u4e8e\u89d2\u8272\u7684\u8138\u76f8\u6bd4\uff0c\u4e4d\u4e00\u770b\u5f88\u7ec6\u5c0f\u3002\u5b9e\u9645\u4e0a\u7edd\u5bf9\u5c3a\u5bf8\u4e0e\u4f8b1\u662f\u76f8\u8fd1\u7684  </li> </ul>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/","title":"\u52a8\u89c4\u7684\u603b\u7ed3","text":""},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#01","title":"01 \u52a8\u753b\u662f\u4e3a\u4e86\u5b9e\u73b0\u8868\u6f14","text":"<p>\u6211\u4eec\u753b\u52a8\u753b\u662f\u4e3a\u4e86\u5b9e\u73b0\u8868\u6f14 \u8868\u6f14\u662f\u4e3a\u4e86\u8bb2\u6e05\u6545\u4e8b \u8fd9\u4e2a\u662f\u6211\u4eec\u7684\u57fa\u672c\u903b\u8f91 \u90a3\u4e48\u8fd9\u4e2a\u5c0f\u7403\u8981\u600e\u4e48\u753b\u5c31\u53d6\u51b3\u4e8e\u54b1\u9700\u8981\u4ec0\u4e48\u6837\u7684\u8868\u6f14 \u6211\u4eec\u53ef\u4ee5\u5927\u81f4\u5206\u4e3a\u4e24\u79cd \u4e00\u79cd\u662f\u5199\u5b9e\u7684\u8868\u6f14\uff0c\u4e00\u79cd\u662f\u5938\u5f20\u7684\u8868\u6f14  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#011","title":"011 \u5199\u5b9e\u7684\u8868\u6f14","text":"<p>\u4ece\u5199\u5b9e\u5f00\u59cb\u8bf4  </p> <p>\u54b1\u9ad8\u4e2d\u7269\u7406\u6709\u4e00\u4e2a\u4e1c\u897f\u53eb\uff0c\u6253\u70b9\u8ba1\u65f6\u5668  \u7eb8\u5e26\u5b50\u4e0a\u7684\u70b9\u4f1a\u8bb0\u5f55\u62c9\u7740\u4ed6\u7684\u7269\u4f53\u7684\u8fd0\u52a8 \u6bcf\u4e2a\u70b9\u4e4b\u95f4\uff0c\u65f6\u95f4\u662f\u4e0d\u53d8\u7684   \u52a8\u753b\u7684\u6bcf\u4e00\u5e27\u4e4b\u95f4\uff0c\u65f6\u95f4\u4e5f\u662f\u4e0d\u53d8\u7684 \u5c0f\u7403\u7684\u901f\u5ea6\u53d1\u751f\u53d8\u5316\uff0c\u5c31\u662f\u4ece\u5355\u4f4d\u65f6\u95f4\u901a\u8fc7\u7684\u8ddd\u79bb\u5b9e\u73b0\u7684  </p> <p>\u7269\u4f53\u7684\u8fd0\u52a8\uff0c\u4ed6\u662f\u5728\u65f6\u95f4\u91cc\u8fde\u7eed\u53d1\u751f\u7684 \u52a8\u753b\u662f\u753b\u51fa\u8fde\u7eed\u52a8\u4f5c\u91cc\u7684\u5207\u7247 \u8ba9\u89c2\u4f17\u4ea7\u751f\uff0c\u57fa\u4e8e\u89c6\u89c9\u6682\u7559\u7684\u9519\u89c9 \u5982\u679c\u8981\u5199\u5b9e\u5c31\u662f\uff0c\u6309\u7167\u4e8b\u60c5\u53d1\u751f\u7684\u65f6\u95f4\u5c3a\u5ea6\uff0c\u5e73\u5747\u5730\u622a\u53d6  </p> <p>\u5305\u5b50     \u5982\u679c\u8981\u5199\u5b9e\u5c31\u662f\uff0c\u6309\u7167\u4e8b\u60c5\u53d1\u751f\u7684\u65f6\u95f4\u5c3a\u5ea6\uff0c\u5e73\u5747\u5730\u622a\u53d6     \u53ef\u662f\u7269\u4f53\u81ea\u7531\u843d\u4f53\u4e0d\u662f\u6709\u52a0\u901f\u5ea6\u5417    \u84dd\u84dd     \u6211\u662f\u8bf4\uff0c\u5728\u65f6\u95f4\u5c3a\u5ea6\u4e0a\u5e73\u5747\u622a\u53d6\uff0c        \u6bd4\u5982         \u7b2c\u4e00\u79d2\u4ed6\u8fd0\u52a8\u4e861\uff0c\u7b2c\u4e8c\u79d2\u8fd0\u52a84\uff0c\u7b2c\u4e09\u79d29    </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#012","title":"012 \u5938\u5f20\u7684\u8868\u6f14","text":"<p>\u5982\u679c\u8981\u5938\u5f20\u5462 \u6bd4\u5982\uff0c\u6211\u8981\u8ba9\u8fd9\u4e2a\u5c0f\u7403\u5f39\u8d77\u6765\u7684\u529b\u5ea6\u770b\u8d77\u6765\u66f4\u5f3a\uff01 \u8981\u600e\u4e48\u505a\u5462   </p> <p>\u8fd9\u6709\u4e00\u4e2a\u6211\u6700\u8fd1\u609f\u5230\u7684\u4e1c\u897f\uff08\uff08\uff08\u73a9\u602a\u730e\u5927\u5251\u609f\u5230\u7684\uff09   \u5c31\u662f\u5fc3\u7406\u9884\u671f </p> <p>\u4e00\u4e2a\u62f3\u5934\uff0c\u84c4\u529b\u8d8a\u4e45\uff0c\u5c31\u4f1a\u8ba9\u89c2\u4f17\u611f\u89c9\u4ed6\u529b\u6c14\u5927 \u4ed6\u84c4\u529b\u7684\u65f6\u5019\u5c31\u662f\u5728\u79ef\u7d2f\u89c2\u4f17\u7684\u9884\u671f \u7136\u540e\u4ed6\u91ca\u653e\u4e86\u7684\u65f6\u5019\uff0c\u76f8\u5e94\u7684\u9020\u6210\u5f88\u5927\u7684\u7834\u574f\uff0c\u5c31\u662f\u56de\u5e94\u4e86\u89c2\u4f17\u7684\u9884\u671f \u4e24\u8005\u547c\u5e94\u5c31\u4f1a\u8ba9\u89c2\u4f17\u611f\u89c9\u5f88\u723d \u5982\u679c\u4f60\u8981\u8ba9\uff0c\u5c0f\u7403\u5f39\u8d77\u6765\u529b\u6c14\u66f4\u5927\uff0c\u5c31\u53ef\u4ee5\u589e\u52a0\u4ed6\u8db4\u5728\u5730\u4e0a\u7684\u65f6\u95f4 \u5305\u5b50     \u4f46\u662f\u5982\u679c\u505c\u592a\u4e45     \u8fd9\u4e2a\u62f3\u5c31\u4fbf\u79d8\u6253\u4e0d\u51fa\u53bb\u4e86  </p> <p>\u84dd\u84dd     \u89c9\u5f97\u4fbf\u79d8\u53ef\u80fd\u5c31\u662f\uff0c\u4e4b\u540e\u7684\u7ed3\u679c\uff0c\u6ca1\u6709\u56de\u5e94\u89c2\u4f17\u7684\u9884\u671f       \u6bd4\u5982\u4f60\u84c4\u529b\u4e861\u79d2\u591a\uff0c\u7ed3\u679c\u53ea\u5f39\u8d77\u6765\u4e00\u70b9\u70b9\uff0c\u5c31\u4f1a\u89c9\u5f97\uff0c\u5f88\u4fbf\u79d8     \u8fd9\u4e2a\u89e3\u51b3\u529e\u6cd5     \u4f60\u4e0d\u80fd\u5355\u7eaf\u8ba9\u4ed6\u505c \u6bd4\u5982\u4f60\u7684\u6574\u4e2a\u52a8\u753b\u662f\u4e00\u62cd\u4e8c\u7684 \u90a3\u4e48\u4f60\u7684\u6240\u6709\u52a8\u4f5c\u90fd\u8981\u4e24\u683c\u53d8\u5316\u4e00\u6b21 \u4f60\u53ef\u4ee5\u7406\u89e3\u4e3a\uff0c\u628a\u4ed6\u5728\u5730\u4e0a\u7684\u90a3\u4e00\u6bb5\u65f6\u95f4\uff0c\u5ef6\u957f\u4e86 \u4f60\u53ef\u4ee5\u5168\u90e82\u683c\u62164\u683c \u4f46\u662f\u6700\u597d\u907f\u514d\u6df7\u62cd \u6df7\u62cd\u4f1a\u4ea7\u751f\u522b\u7684\u6548\u679c \u5982\u679c\u4ed6\u7a81\u7136\u53d8\u6210\u62cd4\uff0c\u89c2\u4f17\u7684\u611f\u5b98\u662f\uff0c\u52a8\u753b\u7a81\u7136\u6682\u505c\u4e86\u4e00\u4e0b \u540c\u6837\u7684\uff0c\u7a81\u7136\u53d8\u6210\u62cd1\uff0c\u611f\u89c9\u5c31\u662f\u7a81\u7136\u88ab\u5feb\u653e\u4e86  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#02","title":"02 \u53d8\u5f62\u62c9\u4f38","text":""},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#021","title":"021 \u53d8\u5f62\u62c9\u4f38\u7684\u5b9e\u8d28\u53ef\u80fd\u4e0d\u662f\u53d8\u5f62\u62c9\u4f38","text":"<p>\u84dd\u84dd     \u4f60\u601d\u8003\u4e00\u4e0b\uff0c\u7403\u62c9\u957f\u7684\u539f\u56e0\u662f\u4ec0\u4e48  </p> <p>\u5305\u5b50     \u55ef\uff0c     \u55ef\uff0c\u2026\u8fd9\u662f\u4e2a\u7269\u7406\u73b0\u8c61     \u539f\u7406\u8ddf\u957f\u5f39\u7c27\u677e\u624b\u4e00\u7aef\u5728\u7a7a\u4e2d\u9759\u6b62\u5e94\u8be5\u5dee\u4e0d\u591a     \u6211\u4e5f\u8bf4\u4e0d\u592a\u6e05\u695a     \u538b\u6241\u5c31\u662f\u60ef\u6027  </p> <p>\u84dd\u84dd     \u4ed6\u5728\u7a7a\u4e2d\u81ea\u7531\u843d\u4f53\u53d7\u5230\u4ec0\u4e48\u529b\uff01  </p> <p>\u5305\u5b50     \u91cd\u529b\uff09  </p> <p>\u84dd\u84dd     \u4ed6\u53ea\u53d7\u4e00\u4e2a\u529b\u4e3a\u4ec0\u4e48\u4f1a\u88ab\u62c9\u957f\u5462     \u4e8b\u5b9e\u5c31\u662f\u4ed6\u538b\u6839\u4e0d\u4f1a\u88ab\u62c9\u957f    </p> <p>\u5305\u5b50     \u7b49\u4e0b     \u52a8\u753b\u5341\u4e8c\u6cd5\u5219\u91cc\u9762\u90a3\u4e2a\u7403\u6389\u4e0b\u53bb         \u597d\u50cf\u786e\u5b9e\u62c9\u4f38\u4e86 </p> <p>\u84dd\u84dd     \u662f\u554a\uff0c\u4f46\u662f\u6211\u540e\u6765\uff0c\u4ed4\u7ec6\u601d\u8003\uff0c\uff0c     \u4ec0\u4e48\u60c5\u51b5\u4e0b\u4f1a\u628a\u7269\u4f53\u50cf\u76ae\u7b4b\u4e00\u6837\u62c9\u957f     \u662f\u8fd9\u4e2a\u5c0f\u7403\u7684\u5f39\u6027\u8fd9\u4e2a\u7279\u70b9\u8bef\u5bfc\u4e86\u6211\u4eec      \u6211\u76f4\u63a5\u8bf4\u7ed3\u8bba\u5427 </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#022","title":"022 \u52a8\u6001\u6a21\u7cca","text":"<p>\u6211\u4eec\u6765\u4ecb\u7ecd\u4e00\u4e2a\u65b0\u7684\u6982\u5ff5  \u52a8\u6001\u6a21\u7cca  </p> <p>\u5c0f\u7403\u4e0b\u843d\u7684\u65f6\u5019\uff0c\u901f\u5ea6\u53d8\u5feb\uff0c\u6240\u4ee5\u88ab\u62c9\u957f \u8fd9\u4e2a\u62c9\u957f\u5176\u5b9e\u662f\u548c\u7269\u4f53\u5728\u5c4f\u5e55\u4e0a\u7684\u901f\u5ea6\u6709\u5173 \u6211\u4eec\u5728\u62cd\u7167\u7684\u65f6\u5019\uff0c\u5982\u679c\u7269\u4f53\u901f\u5ea6\u5f88\u5feb\u5c31\u4f1a\u5f88\u6a21\u7cca\uff0c\u7559\u4e0b\u62d6\u5f71 \u56e0\u4e3a\u7167\u7247\u8bb0\u5f55\u7684\u4e0d\u662f\u6309\u4e0b\u5feb\u95e8\u7684\u77ac\u95f4   \u800c\u662f\u5feb\u95e8\u6253\u5f00\u5230\u5173\u95ed\u7684\u8fd9\u4e00\u6bb5\u65f6\u95f4  </p> <p>\u4e0e\u4e4b\u76f8\u540c   \u6211\u4eec\u7ed8\u5236\u52a8\u753b\uff0c\u6bcf\u4e00\u5e27\u52a8\u753b\u4ed6\u90fd\u662f\u4e00\u4e2a\u65f6\u95f4\u7247\u6bb5  \u901f\u5ea6\u8d8a\u5feb\uff0c\u5c31\u4f1a\u5728\u753b\u9762\u4e0a\u7559\u4e0b\u4ed6\u7684\u8f68\u8ff9   </p> <p>\u6211\u7ed9\u4f60\u770b\u6211\u7684\u4e00\u4e2a\u7ec3\u4e60 \u8fd9\u4e2a\u6fc0\u5149\u7b14\u7684\u5149\u70b9 \u4e8b\u5b9e\u59cb\u7ec8\u662f\u4e00\u4e2a\u70b9 \u4ed6\u6ca1\u6709\u5b9e\u4f53  \u4e3a\u4ec0\u4e48\u4e5f\u80fd\u88ab\u62c9\u957f\u5462  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#023","title":"023 \u89c6\u89c9\u8865\u507f","text":"<p>\u5305\u5b50     \u90a3\u4e48\u53d8\u7a84\u4e5f\u662f\u4e0d\u592a\u5408\u9002\u7684\u662f\u5427     \u90a3\u4e2a\u7403     12\u6cd5\u5219\u4e3a\u4ec0\u4e48\u8981\u53d8\u7a84\u5462\uff09  </p> <p>\u53ef\u80fd\u662f\u89c6\u89c9\u8865\u507f \u5728\u5b9e\u62cd\u4e2d \u8d8a\u662f\u65e9\u7684\u62d6\u5f71\uff0c\u900f\u660e\u5ea6\u4f1a\u8d8a\u4f4e\uff0c\u8d8a\u6a21\u7cca \u8fd9\u4e00\u90e8\u5206\u62d6\u5f71\u5728\u89c6\u89c9\u4e2d\u7684\u6743\u91cd\u5c31\u4f4e  </p> <p>\u4f46\u662f\u624b\u7ed8\u641e\u8fd9\u4e2a\u5f88\u9ebb\u70e6 \u4e0d\u5982\uff0c\u964d\u4f4e\u4ed6\u7684\u9762\u79ef \u4e5f\u5e73\u8861\u4e86\u4ed6\u7684\u89c6\u89c9\u6743\u91cd 12\u6cd5\u5219\u8bf4\uff0c\u8981\u8ba9\u8fd9\u4e2a\u7403\uff0c\u65e0\u8bba\u538b\u6241\u8fd8\u662f\u62c9\u4f38 \u90fd\u8981\u9762\u79ef\u76f8\u5f53 \u6211\u89c9\u5f97\u8fd9\u4e2a\u5c31\u662f\u57fa\u4e8e\u6734\u7d20\u7684\u89c6\u89c9\u611f\u53d7\u63d0\u51fa\u7684 \u8fd9\u6837\u505a\u53ef\u4ee5\u8ba9\u8fd9\u4e2a\u7269\u4f53\u7684\u89c6\u89c9\u6743\u91cd\u59cb\u7ec8\u4fdd\u6301\u5e73\u8861  </p>"},{"location":"anime/%E5%8A%A8%E8%A7%84%E7%9A%84%E6%80%BB%E7%BB%93/#024","title":"024 \u5b9e\u9645\u4e0a\u4e5f\u771f\u7684\u6709\u53d1\u751f\u53d8\u5f62\u7684\u65f6\u5019","text":"<p>\u6709\u4e2a\u70b9\uff0c\uff0c\u5c31\u662f\u5c0f\u7403\u5f39\u8d77\u6765\u7684\u65f6\u5019   \u4ed6\u662f\u771f\u7684\u4f1a\u53d8\u7ec6  \u662f\u5f39\u5730\u7684\u65f6\u5019\uff0c\u538b\u7f29\u7684\u53cd\u4f5c\u7528\u5bfc\u81f4\u7684    </p>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/","title":"\u4f3d\u9a6c\u503c\u3001\u7070\u5ea6\u7cfb\u6570","text":""},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_1","title":"\u6570\u7801\u56fe\u7247\u8bb0\u5f55\u548c\u5448\u73b0\u7684\u8fc7\u7a0b","text":"<ol> <li> <p>cmos\u901a\u7535\u66dd\u5149\uff0c\u4ea7\u751f\u6a21\u62df\u7535\u4fe1\u53f7</p> </li> <li> <p>\u7ecf\u8fc7\u6a21\u6570\u8f6c\u6362\uff0c\u4ea7\u751fraw\u6570\u636e</p> <ul> <li>raw\u5e76\u975e\u56fe\u7247\u7684\u7f16\u7801</li> <li>raw\u8bb0\u5f55\u7684\u4eae\u5ea6\u4fe1\u606f\u662f\u7ebf\u6027\u7684</li> <li>raw\u6ca1\u6709\u4f4d\u6df1\u5ea6\uff0c\u6ca1\u6709\u4f3d\u9a6c\u7f16\u7801\uff0c\u6ca1\u6709\u8272\u5f69\u7a7a\u95f4</li> </ul> </li> <li> <p>raw\u4fe1\u606fISP\u5904\u7406</p> <ul> <li>\u7528\u63d2\u503c\u7b97\u6cd5\u7b97\u51fa\u62dc\u5c14\u9635\u5217\u4e2d\u6bcf\u4e2a\u50cf\u7d20\u7684RGB\u503c</li> <li>\u5c06\u8ba1\u7b97\u597d\u7684RGB\u503c\u6620\u5c04\u5230\u4e00\u4e2a\u8272\u5f69\u7a7a\u95f4\u4e2d</li> <li>\u5bf9\u7ebf\u6027\u53d8\u5316\u7684RGB\u503c\u5e94\u7528\u4f3d\u9a6c\u66f2\u7ebf\uff0c<code>\u8f93\u51fa = \u8f93\u5165^(1/2.2)</code>\u3002\u5c06\u7ebf\u6027\u7684\u5149\u7ebf\u6570\u636e\u8f6c\u6362\u4f4d\u975e\u7ebf\u6027\u7684\u56fe\u50cf\u6570\u636e\uff0c\u4ee5\u5339\u914d\u4eba\u773c\u89c6\u89c9\u548c\u663e\u793a\u8bbe\u5907\u7684\u7279\u6027</li> </ul> </li> <li> <p>\u538b\u7f29\u4e3aJPG\u50a8\u5b58</p> </li> </ol>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_2","title":"\u4e3a\u4f55\u5e94\u7528\u4f3d\u9a6c\u66f2\u7ebf\u7f16\u7801","text":"<p>\u53c2\u8003\u6587\u732eUnderstanding Gamma Correction</p>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_3","title":"\u4eba\u773c\u7684\u7279\u6027","text":"<p>\u4eba\u773c\u5bf9\u5149\u5f3a\u5ea6\u7684\u611f\u77e5\u4e0d\u662f\u7ebf\u6027\u7684\u3002\u4eba\u773c\u5bf9\u6697\u90e8\u533a\u57df\u7684\u4eae\u5ea6\u53d8\u5316\u66f4\u654f\u611f\uff0c\u5bf9\u4eae\u90e8\u533a\u57df\u7684\u4eae\u5ea6\u53d8\u5316\u66f4\u8fdf\u949d\u3002\u800c\u5bf9\u4e8e\u6570\u7801\u76f8\u673a\uff0c\u4e24\u500d\u6570\u91cf\u7684\u5149\u5b50\u51fb\u4e2d\u4f20\u611f\u5668\u65f6\uff0c\u5b83\u63a5\u6536\u5230\u4e24\u500d\u7684\u4fe1\u53f7\uff08\u201c\u7ebf\u6027\u201d\u5173\u7cfb\uff09  </p> <p>\u7ebf\u6027\u8272\u57df\u768450%\u4eae\u5ea6\u4e0e\u4eba\u773c\u8ba4\u4e3a\u7684\u4e2d\u95f4\u7070</p> <p>\u97e6\u4f2f-\u8d39\u5e0c\u7eb3\u5b9a\u5f8b\u8ba4\u4e3a\u523a\u6fc0\u5f3a\u5ea6\u4e0e\u523a\u6fc0\u5f15\u8d77\u7684\u611f\u89c9\u5e45\u5ea6\uff0c\u5448\u5bf9\u6570\u51fd\u6570\u7684\u5173\u7cfb\u3002  \u53f2\u8482\u6587\u65af\u5219\u7528\u5e42\u5f8b\u63cf\u8ff0\u4e86\u66f4\u5e7f\u6cdb\u7684\u611f\u89c9\u6bd4\u8f83\u8303\u56f4\uff0c\u76f4\u81f3\u96f6\u5f3a\u5ea6\u3002   </p> Text Only<pre><code>sense = k * phisic^ ( 1/ gamma )\n</code></pre> <p>\u56fe\u50cf\u5904\u7406\u4e2dgamma\u503c\u901a\u5e38\u53d62.2\uff0ck\u503c\u4f5c\u4e3a\u4e00\u4e2a\u53ef\u9009\u7684\u7f29\u653e\u7cfb\u6570\uff0c\u901a\u5e38\u4e3a1  </p> Text Only<pre><code>v_out = v_in^ ( 1/ 2.2 )\n</code></pre>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_4","title":"\u4f4d\u6df1\u5ea6\u7684\u9650\u5236","text":"<p>\u4f4d\u6df1\u5ea6\u89c4\u5b9a\u4e86\u6bcf\u4e2a\u989c\u8272\u901a\u9053\u53ef\u7528\u7684\u4eae\u5ea6\u7ea7\u522b\u6570\u91cf  \u4e00\u4e2a8bit\uff08\u4f4d\uff09\u6df1\u5ea6\u7684\u56fe\u50cf\uff0c\u6bcf\u4e2a\u901a\u9053\u53ea\u6709256\u4e2a\u4eae\u5ea6\u7ea7\u522b \u82e5\u6211\u4eec\u5c06\u4ec5\u6709\u7684256\u4e2a\u4eae\u5ea6\u7ea7\u522b\uff0c\u5e73\u5747\u5730\u5206\u914d\u7ed9\u7ebf\u6027\u7684raw\u6570\u636e\u3002<code>0</code>\u4ee3\u8868\u7eaf\u9ed1\uff0c<code>1,2,3,...</code>\u5747\u5300\u589e\u52a0\u4eae\u5ea6\uff0c\u800c<code>255</code>\u4ee3\u8868\u6700\u4eae \u90a3\u4e48\u5bf9\u4e8e\u4eba\u773c\u6765\u8bf4\uff0c5\u52306\u53d8\u4eae\u4e8620%\uff0c\u800c200\u5230201\u53ea\u589e\u52a0\u4e860.5% \u6697\u90e8\u533a\u57df\u5c06\u4f1a\u51fa\u73b0\u660e\u663e\u7684\u8272\u9636\u65ad\u88c2 \u3002\u800c\u4eae\u90e8\u7684\u53d8\u5316\u5219\u8fc7\u4e8e\u7ec6\u5fae\uff0c\u96be\u4ee5\u5206\u8fa8\u3002\u5927\u91cf\u6570\u636e\u4f4d\u88ab\u6d6a\u8d39\u5728\u4e86\u4eae\u90e8\u533a\u57df \u56e0\u6b64\uff0c\u4f4d\u6df1\u5ea6\u4f4e\u7684\u56fe\u50cf\u66f4\u4f9d\u8d56\u4f3d\u9a6c\u66f2\u7ebf\uff0c\u901a\u8fc7\u4e00\u4e2a\u975e\u7ebf\u6027\u7684\u8f6c\u6362\u8fc7\u7a0b\uff0c\u91cd\u65b0\u5206\u914d\u8fd9256\u4e2a\u6570\u503c\u7b49\u7ea7  </p> <p>\u7ebf\u6027\u7684raw\u6570\u636e</p> <p>\u4f7f\u752832\u7ea7\uff085\u4f4d\uff09\u8fdb\u884c\u7ebf\u6027\u7f16\u7801</p> <p>\u5e94\u7528\u4f3d\u9a6c\u66f2\u7ebf\u7f16\u7801</p>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_5","title":"\u4f3d\u9a6c\u66f2\u7ebf\u7684\u7f16\u7801\u548c\u77eb\u6b63","text":"<ol> <li>\u56fe\u50cf\u4f3d\u9a6c<ul> <li>raw\u8f6c\u6362\u4e3aJPEG\u6216TIFF\u7b49\u683c\u5f0f\u65f6\uff0c\u5e94\u7528\u4f3d\u9a6c\u66f2\u7ebf\u91cd\u65b0\u5206\u914d\u4eae\u5ea6\u7b49\u7ea7</li> <li>\u4ee5\u66f4\u6709\u6548\u5730\u5229\u7528\u4f4d\u6df1\u5ea6</li> <li>\u4f3d\u9a6c\u66f2\u7ebf\u538b\u7f29\u4e86\u4eae\u90e8\u7684\u4fe1\u606f\uff0c\u56fe\u50cf\u4f3d\u9a6c\u4e5f\u53ef\u4ee5\u88ab\u89c6\u4e3a\u4f3d\u9a6c\u538b\u7f29\uff0c\u663e\u793a\u4f3d\u9a6c\u53ef\u4ee5\u88ab\u89c6\u4e3a\u4f3d\u9a6c\u6269\u5c55</li> </ul> </li> <li>\u663e\u793a\u4f3d\u9a6c<ul> <li>\u8865\u507f\u56fe\u50cf\u4f3d\u9a6c\uff0c\u4f7f\u5f97\u56fe\u50cf\u56de\u5230\u6b63\u786e\u7684\u989c\u8272\u4e0a\uff0c\u5426\u5219\u56fe\u50cf\u4f1a\u6bd4\u6b63\u786e\u7684\u989c\u8272\u66f4\u4eae</li> <li>\u4e1a\u754c\u5927\u90e8\u5206\u5df2\u91c7\u75282.2\u7684\u6807\u51c6\u4f3d\u9a6c\u503c</li> <li>\u663e\u793a\u5668\u5177\u6709\u4e00\u4e2a\u539f\u751f\u4f3d\u9a6c\u503c\u3002\u5728CRT\u663e\u793a\u5668\u4e0a\u662f2.5\uff0c\u663e\u5361\u53ea\u9700\u8981\u5bf9\u5176\u5e94\u75281.1\u7684\uff0c\u5c31\u53ef\u4ee5\u5b9e\u73b02.2\u7684\u6574\u4f53\u663e\u793a\u4f3d\u9a6c\u3002\u800c\u6db2\u6676\u663e\u793a\u5668\u7684\u6570\u636e\u5e76\u4e0d\u4e00\u81f4\uff0c\u9700\u8981\u66f4\u591a\u7684\u6821\u6b63</li> <li>\u9664\u4e86\u663e\u793a\u5668\uff0c\u4f3d\u9a6c\u503c\u8fd8\u53ef\u4ee5\u4ee5\u7c7b\u4f3c\u7684\u65b9\u6cd5\u4f5c\u7528\u5728\u6253\u5370\u673a\u4e0a</li> </ul> </li> <li>\u7cfb\u7edf\u4f3d\u9a6c<ul> <li>\u5e94\u7528\u4e8e\u56fe\u50cf\u7684\u6240\u6709\u4f3d\u9a6c\u66f2\u7ebf\u7684\u51c0\u503c\uff0c\u5305\u542b\u4e86\u56fe\u50cf\u4f3d\u9a6c\u548c\u663e\u793a\u4f3d\u9a6c\u7684\u7efc\u5408\u4f5c\u7528</li> <li>\u4e3a\u4e86\u5fe0\u5b9e\u5730\u8868\u73b0\u6b63\u786e\u7684\u56fe\u7247\uff0c\u5e94\u5f53\u4f7f\u5f97\u7cfb\u7edf\u4f3d\u9a6c\u63a5\u8fd1\u4e00\u6761\u76f4\u7ebf\uff0c\u4e5f\u5c31\u662f\u4f7f\u5f97gamma=1.0</li> <li>\u5982\u679c\u7cfb\u7edf\u4f3d\u9a6c\u6821\u51c6\u4e0d\u8db3\uff0c\u4f1a\u4f7f\u5f97\u753b\u9762\u504f\u4eae\uff0c\u5bf9\u6bd4\u5ea6\u504f\u4f4e\u3002\u53cd\u4e4b\uff0c\u5982\u679c\u8fc7\u5ea6\u8865\u507f\u4e86\uff0c\u753b\u9762\u4f1a\u53d8\u6697\uff0c\u5bf9\u6bd4\u5ea6\u66f4\u5927</li> </ul> </li> </ol>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_6","title":"\u975e\u5fc5\u987b\u548c\u4e0d\u9002\u7528\u60c5\u51b5","text":"<ul> <li>\u4f3d\u9a6c\u66f2\u7ebf\u4e0d\u662f\u5fc5\u987b\u7684\u3002\u5982\u679c\u7ebf\u6027\u7684raw\u56fe\u50cf\u5728\u7ebf\u6027\u7684\u663e\u793a\u5668\u4e0a\u5c55\u793a\uff0c\u6211\u4eec\u4ecd\u4f1a\u770b\u5230\u6b63\u786e\u7684\u56fe\u50cf</li> <li>sRGB\u8272\u5f69\u7a7a\u95f4\u5728\u975e\u5e38\u4f4e\u7684\u4eae\u5ea6\u5448\u7ebf\u6027\uff0c\u5728\u8f83\u9ad8\u4eae\u5ea6\u7684\u6307\u6570\u5219\u4e3a2.4\u3002\u4f3d\u9a6c\u503c\u4e3a2.2\u7684\u7b80\u5355\u5e42\u51fd\u6570\u53ea\u662f\u6574\u4f53\u8fd1\u4f3csRGB\u7684\u66f2\u7ebf</li> </ul>"},{"location":"draw/%E4%BC%BD%E9%A9%AC%E5%80%BC%E3%80%81%E7%81%B0%E5%BA%A6%E7%B3%BB%E6%95%B0/#_7","title":"\u7070\u5ea6\u7cfb\u6570","text":"<p>PhotoShop\u7684\u8272\u9636\u5de5\u5177\u4e2d \u4e2d\u95f4\u6ed1\u5757\u4e0b\u65b9\u5bf9\u5e94\u7684\u6570\u503c1.00\uff0c\u662f\u5f53\u524d\u56fe\u50cf\u7684\u7070\u5ea6\u7cfb\u6570 \u4e5f\u5c31\u662f\u5f53\u524d\u56fe\u50cf\u7684\u7cfb\u7edf\u4f3d\u9a6c\u503c \u4e2d\u95f4\u6ed1\u5757\u6c38\u8fdc\u5bf9\u5e9450%\u4eae\u5ea6 \u8c03\u8282\u8272\u9636\uff0c\u5b9e\u9645\u4e0a\u662f\u901a\u8fc7\u8c03\u828250%\u4eae\u5ea6\u5bf9\u5e94\u7684\u4f4d\u7f6e\uff0c\u6765\u53ef\u89c6\u5316\u7684\u8c03\u8282\u7cfb\u7edf\u4f3d\u9a6c\u503c </p>"},{"location":"draw/%E5%85%B3%E4%BA%8E%E7%BA%BF%E6%9D%A1%E7%9A%84%E6%80%BB%E7%BB%93/","title":"\u5173\u4e8e\u7ebf\u6761\u7684\u603b\u7ed3","text":"<p> X \u4e0a\u7684 \u308a\u3087\u30fc\u3061\u3082 \u0398_\u0398@\uff1a\u201c\u6700\u8fd1\u306e\u307e\u3068\u3081\u3002 \u7dda\u306e\u592a\u3055\u306b\u610f\u5473\u304c\u3042\u308a\u307e\u3057\u305f\u3002 \u30e9\u30d5\u306f\u592a\u3044\u7dda\u3067\u63cf\u304f\u3053\u3068\uff01 \u3044\u304d\u306a\u308a\u7d30\u304f\u63cf\u304b\u306a\u3044\u3067\u5c11\u3057\u305a\u3064\u6bb5\u968e\u3092\u7d4c\u3066\u7d30\u304f\u63cf\u3044\u3066\u7d75\u3092\u5b8c\u6210\u3055\u305b\u308b\u3053\u3068\u3002 \u7d30\u3055\u306f\u5929\u6575\uff01 https://t.co/zpRF3kTsLN\u201d / X (twitter.com)</p> <p>\u770b1\u89c9\u5f97\u8212\u670d \u539f\u56e0\u662f1\u5404\u5904\u7684\u9ed1\u7ebf\u7684\u6743\u91cd\u8fbe\u6210\u4e86\u4e00\u79cd\u5e73\u8861 \u6211\u4eec\u7528\u7c97\u7ebf\u6761\u753b\u8349\u56fe\u7684\u65f6\u5019\uff0c\u6bd4\u8f83\u5bb9\u6613\u5173\u6ce8\u8fd9\u79cd\u5e73\u8861  \u4f46\u662f\u4ed6\u5f802\u30013\u7ec6\u5316\u7684\u65f6\u5019 \u4ed6\u6ca1\u6709\u7ee7\u7eed\u8003\u8651\u7ec6\u5316\u4e4b\u540e\u7684\u7ebf\u6761\uff0c\u4ed6\u7684\u9ed1\u767d\u5e73\u8861\u4f1a\u53d1\u751f\u53d8\u5316 \u6bd4\u5982\u8bf4\u4fa7\u53d1\u90a3\u4e00\u6761 \u7ec6\u5316\u4e4b\u540e\uff0c\u53d8\u5f97\u5b58\u5728\u611f\u5f88\u5f3a \u76f4\u76f4\u7684\u7ad6\u4e0b\u6765\u7684\u5370\u8c61\u88ab\u52a0\u5f3a\u4e86 \u8fd8\u6709\uff0c1\u4e2d\u4fa7\u8138\u8fb9\u7f18-\u8116\u5b50-\u80a9\u8180\u8fd9\u4e00\u6761\u7ebf\uff0c\u662f\u5904\u4e8e\u4e00\u4e2a\u5f3a\u8c03\u7684\u72b6\u6001 \u753b\u52303\uff0c\u8fd9\u6761\u8fb9\u7f18\u5c31\u4e22\u5931\u4e86  </p> <p> \u6211\u4eec\u753b\u7ebf\u7684\u65f6\u5019\uff0c\u4e0d\u5e94\u8be5\u628a\u7ebf\u5f53\u6210\u7ed3\u6784\u7684\u9644\u5eb8 \u6bd4\u5982\u6211\u60f3\u8868\u73b0\u4ed6\u7684\u773c\u7751\u3001\u5367\u8695 \u5982\u679c\u6211\u7528\u9ed1\u7ebf\u753b\uff0c\uff0c\u8fd9\u4e2a\u5367\u8695\u5c31\u548c\u4e0a\u773c\u7751\u4e00\u6837\u5f3a\u4e86  </p>"},{"location":"draw/%E5%85%B3%E4%BA%8E%E8%B4%A8%E6%84%9F%E7%9A%84%E6%80%BB%E7%BB%93/","title":"\u5173\u4e8e\u8d28\u611f\u7684\u603b\u7ed3","text":"<p>\u8003\u5b66\u7684\u65f6\u5019\uff0c\u8001\u5e08\u8bf4\u753b\u753b\u7684\u51e0\u4e2a\u65b9\u9762\u662f\u8981\u4e00\u6b65\u4e00\u6b65\u6765 \u5f62\u72b6\uff0c\u4f53\u79ef\uff08\u91cf\u611f\uff09\uff0c\u7ed3\u6784\uff0c\u5149\u5f71\uff08\u5149\u611f\uff09\uff0c\u6750\u8d28\uff08\u8d28\u611f\uff09     \u91cf\u611f\u5373\uff0c\u5728\u7a7a\u95f4\u4e2d\u5360\u636e\u4e00\u5b9a\u91cf\u7684\u611f\u89c9 \u4f46\u662f\u4ed6\u8fd9\u4e2a\u56fe\u5b8c\u5168\u6ca1\u6709\u53bb\u753b\u4e00\u4e2a\u6bd4\u8f83\u82e6\u5927\u4ec7\u6df1\u7684\u7ec6\u81f4\u5149\u5f71 \u76f4\u63a5\u505a\u4e86\u76ae\u80a4\u7684\u8d28\u611f  </p>"},{"location":"draw/%E5%85%B3%E4%BA%8E%E8%B4%A8%E6%84%9F%E7%9A%84%E6%80%BB%E7%BB%93/#_1","title":"\u8d28\u611f","text":"<p>\u6240\u8c13\uff0c\u8d28\u611f \u5c31\u662f\uff0c\u8fd9\u4e2a\u7269\u4f53\u7684\u8868\u9762\uff0c\u5177\u6709\u4ec0\u4e48\u6837\u7684\u6027\u8d28 \u6bd4\u5982\uff0c\u7eb8\u662f\u7c97\u7cd9\u7684\uff0c\u73bb\u7483\u662f\u5149\u6ed1\u7684  \u7c97\u7cd9\u7684\u4e1c\u897f\u53d1\u751f\u6f2b\u53cd\u5c04\uff0c\u5149\u6ed1\u7684\u53d1\u751f\u955c\u9762\u53cd\u5c04\uff0c\u8fd9\u4e2a\u5c31\u662f\u6bd4\u8f83\u57fa\u672c\u7684  \u6240\u4ee5\u73bb\u7483\u4e0a\u7684\u9ad8\u5149\u5f62\u72b6\u4f1a\u662f\u53cd\u5c04\u7684\u5149\u6e90\u7684\u5f62\u72b6 \u5c31\u662f\u706f\u7684\u5f62\u72b6\uff0c\u592a\u9633\u7684\u5f62\u72b6  \u7eb8\u5c31\u6ca1\u6709\u9ad8\u5149  \u53e6\uff0c\u5728\u8272\u5c42\u5206\u754c\u5904\uff08\u660e\u6697\u4ea4\u754c\u7ebf\uff09\u4f1a\u51f8\u663e\u51fa\u7269\u4f53\u8868\u9762\u7684\u7eb9\u7406\u7ed3\u6784 \u4f8b\u5982\u6708\u7403\u8868\u9762\u7684\u7eb9\u7406\uff0c\u4f1a\u5728\u5149\u6697\u5206\u754c\u7684\u5730\u65b9\u7279\u522b\u660e\u663e \u800c\u672c\u6848\u4f8b\u56fe\u4e2d\u4e5f\u5229\u7528\u9ad8\u5149\u8fb9\u754c\u5904\u7684\u5f62\u72b6\u53d8\u5316\uff0c\u8868\u73b0\u76ae\u80a4\u7ec6\u5fae\u7684\u8d28\u611f   </p>"},{"location":"tools/perscal/","title":"Perscal","text":"\ud83d\udcd0 \u900f\u89c6\u8ba1\u7b97\u5668 v2.0.1 <p>\u7269\u4f53\u7eb5\u6df1\u8fd0\u52a8 \u2192 \u50cf\u7d20\u5c3a\u5bf8\u53d8\u5316 | 35mm\u7b49\u6548\u89c6\u89d2</p> \ud83d\udcf7 \u76f8\u673a &amp; \u7269\u4f53\u53c2\u6570 \u57fa\u7840\u6570\u636e \u753b\u5e03\u5bbd\u5ea6(px) \u753b\u5e03\u9ad8\u5ea6(px) \u7269\u4f53\u5bbd\u5ea6(cm) \u7269\u4f53\u9ad8\u5ea6(cm) \u7269\u8ddd u (cm) \u7126\u8ddd f (mm) \u2728 \u8ba1\u7b97\u521d\u59cb\u53c2\u6570 \u27f3 \u91cd\u7f6e\u5f53\u524d\u4f1a\u8bdd \ud83d\udd0d \u7b49\u6548\u89c6\u89d2 &amp; \u521d\u59cb\u50cf\u5c3a\u5bf8 \u6c34\u5e73FOV (35mm\u7b49\u6548)\u2014 \u5782\u76f4FOV (35mm\u7b49\u6548)\u2014 \ud83d\udcd0 \u521d\u59cb\u50cf\u5bbd\u5ea6(px)\u2014 \ud83d\udccf \u521d\u59cb\u50cf\u9ad8\u5ea6(px)\u2014 \ud83d\udccd \u5f53\u524d\u7269\u8ddd u (cm)\u2014 \ud83c\udfc3 \u7eb5\u6df1\u8fd0\u52a8\u6a21\u62df \u6b65\u957f\u53ef\u6b63/\u8d1f \u6b65\u957f i (cm) \ud83d\udca1 \u9760\u8fd1\u4e3a\u6b63\uff0c\u8fdc\u79bb\u4e3a\u8d1f \u25b6 \u79fb\u52a8\u4e00\u6b65 \u25c0 \u4e0a\u4e00\u6b65 \ud83d\udd04 \u5168\u65b0\u8ba1\u7b97 \u5df2\u79fb\u52a8\u6b65\u65700 \u2728 \u5f53\u524d\u50cf\u5bbd(px)\u2014 \u2728 \u5f53\u524d\u50cf\u9ad8(px)\u2014 \ud83d\udcc9 \u5bbd\u5ea6\u53d8\u5316\u91cf(px)\u2014 \ud83d\udcc9 \u9ad8\u5ea6\u53d8\u5316\u91cf(px)\u2014 \ud83d\udcca \u50cf\u5bbd\u53d8\u5316\u6bd4(%)\u2014 \ud83d\udcca \u50cf\u9ad8\u53d8\u5316\u6bd4(%)\u2014      \u900f\u89c6\u8ba1\u7b97\u5668 \u00b7 \u6a21\u62df\u7269\u4f53\u6cbf\u5149\u8f74\u8fd0\u52a8\u65f6\u50cf\u7d20\u5c3a\u5bf8\u53d8\u5316     X\uff1a@aiyasu1921       \u00a0 | \u00a0     Bili\uff1a501439558"}]}